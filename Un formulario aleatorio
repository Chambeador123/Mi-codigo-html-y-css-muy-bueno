<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="website" content="EL MEJOR SITIO WEB">
        <title>HTML & CSS</title>
        <link rel="stylesheet" href="Text Fileo.css">
    </head>
    <body>
        <!-- Los atributos id estan solamente hechos para el atributo for de el elemento label y no tienen significado para estilos -->
       <form>
        <main>
        <label for="username">Nombre de usuario:</label>
        <input type="text" name="username" id="username" size="30" maxlength="40" style="margin-bottom: 8px;" placeholder="TuNombre123" required>
        <br>
        <label for="password">Contrasena:</label>
        <input type="password" name="password" id="password" style="margin-bottom: 8px;" maxlength="20" minlength="10" placeholder="123456" required>
        <br>
        <label for="email">Email:</label>
        <input type="email" name="email" id="email" style="margin-bottom: 15px;" placeholder="ejemplo@gmail.com" required>
        <br>
        <label for="phonenumber">Numero de telefono</label>
        <input type="tel" name="phonenumber" id="phonenumber" style="margin-bottom: 15px;" 123-456-789 required>
        <br>
        <label for="message">Escribe tu mensaje:</label>
        <br>
        <textarea name="message" id="message" rows="10" cols="20" placeholder="Noticias de ultima semana"></textarea>
        <br>
        <label for="where">Como nos encontraste?:</label>
        <input type="radio" name="where" value="Google" checked="true" required>Google
        <input type="radio" name="where" value="Facebook" required>Facebook
        <input type="radio" name="where" value="Instagram" required>Instagram
        <input type="radio" name="where" value="Otro" required>Otro
        <br>
        <label for="reason">Porque te contactas con nosotros?:</label>
        <input type="checkbox" name="reason" value="Colaboracion">Colaboracion
        <input type="checkbox" name="reason" value="Pregunta">Pregunta
        <input type="checkbox" name="reason" value="Oferta">Oferta
        <input type="checkbox" name="reason" value="Otro">Otro
        <br>
        <label for="continent">De que continente eres?:</label>
        <select name="continent">
            <option value="NorteAmerica">Nortemerica</option>
            <option value="SudaAmerica">Sudaamerica</option>
            <option value="Europa">Europa</option>
            <option value="Asia">Asia</option>
            <option value="Oceania">Oceania</option>
            <option value="Antartida">Antartida</option>
        </select>
        <br>
        <br>
        <label for="pasatiempos">Pasatiempos:</label>
        <br>
        <select name="pasatiempos" size="7" multiple>
            <option value="Videojuegos">Videojuegos</option>
            <option value="Basquetbol">Basquetbol</option>
            <option value="Futbol">Futbol</option>
            <option value="Rugby">Rugby</option>
            <option value="Voleibol">Voleibol</option>
            <option value="Beisbol">Beisbol</option>
            <option value="Otro">Otro</option>
        </select>
        <br>
        <label for="idcolor">Selecciona tu color de identificacion:</label>
        <input type="color" name="idcolor" id="idcolor">
        <br>
        <label for="filesel">Elige tu archivo</label>
        <input type="file" name="filesel" id="filesel"> 
        <br>
        <br>
        <label for="reset">Restablecer el formulario:</label>
        <input type="reset" name="reset" id="reset">
        <br>
        <input type="submit" value="Subir" style="border-radius: 10px; box-shadow: 1px 1px" onclick="alert('Subido! Gracias por tomar el formulario.')">
        </main>
       </form>
    </body>
</html>
